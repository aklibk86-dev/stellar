# Build-time configuration. Explicit VITE_* values override matching public/env.js fields.
VITE_BASE=/
VITE_CDN_URL=
VITE_API_BASE_URL=https://xboard.wf1.one
VITE_BACKEND_TYPE=xboard

VITE_SITE_TITLE=Stellar
VITE_SITE_DESCRIPTION=Stellar Panel

# Client IDs are defined in SubscribeImportModal.vue. Empty means all clients.
VITE_CLIENT_IMPORTS_ENABLED=true
VITE_CLIENT_IMPORTS=ios-shadowrocket,ios-stash,android-flclash,android-v2rayng,windows-clashverge,mac-clashverge

# Supported values: wechat,qq,weibo,twitter,telegram,facebook,copy
VITE_SOCIAL_SHARE_ENABLED=true
VITE_SOCIAL_SHARE_PLATFORMS=wechat,qq,weibo,twitter,telegram,facebook,copy

# Tawk: set property and widget IDs. Custom: set provider=custom and a HTTPS script URL.
VITE_CUSTOMER_SERVICE_ENABLED=false
VITE_CUSTOMER_SERVICE_PROVIDER=tawk
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=default
VITE_CUSTOMER_SERVICE_SCRIPT_URL=
