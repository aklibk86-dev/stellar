# 构建期配置。显式填写的 VITE_* 值会覆盖 public/env.js 中的同名字段。
VITE_BASE=/
VITE_CDN_URL=
VITE_API_BASE_URL=https://xboard.wf1.one
VITE_BACKEND_TYPE=xboard

VITE_SITE_TITLE=Stellar
VITE_SITE_DESCRIPTION=Stellar Panel

# 客户端 ID 在 SubscribeImportModal.vue 中定义。留空表示全部客户端。
VITE_CLIENT_IMPORTS_ENABLED=true
VITE_CLIENT_IMPORTS=ios-shadowrocket,ios-stash,android-flclash,android-v2rayng,windows-clashverge,mac-clashverge

# 可选值：wechat,qq,weibo,twitter,telegram,facebook,copy
VITE_SOCIAL_SHARE_ENABLED=true
VITE_SOCIAL_SHARE_PLATFORMS=wechat,qq,weibo,twitter,telegram,facebook,copy

# 第三方客服服务商：tawk, crisp, chatwoot, intercom, custom。
VITE_CUSTOMER_SERVICE_ENABLED=false
VITE_CUSTOMER_SERVICE_PROVIDER=tawk
VITE_CUSTOMER_SERVICE_LOAD_DELAY=800
VITE_CUSTOMER_SERVICE_LOAD_ON_IDLE=true
VITE_CUSTOMER_SERVICE_IDENTIFY_USER=true
VITE_CUSTOMER_SERVICE_TRACK_PAGE_VIEWS=true
VITE_CUSTOMER_SERVICE_SHOW_ROUTES=
VITE_CUSTOMER_SERVICE_HIDE_ROUTES=/login,/register,/forget
VITE_CUSTOMER_SERVICE_HIDE_ON_MOBILE=false
VITE_CUSTOMER_SERVICE_TAGS=stellar

VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=default
VITE_TAWK_AUTO_START=true

VITE_CRISP_WEBSITE_ID=

VITE_CHATWOOT_BASE_URL=
VITE_CHATWOOT_WEBSITE_TOKEN=
VITE_CHATWOOT_LOCALE=auto
VITE_CHATWOOT_POSITION=right

VITE_INTERCOM_APP_ID=
VITE_INTERCOM_API_BASE=https://api-iam.intercom.io

VITE_CUSTOMER_SERVICE_SCRIPT_URL=
